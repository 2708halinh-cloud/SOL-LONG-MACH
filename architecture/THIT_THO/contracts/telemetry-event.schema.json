{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tesseract:thit-tho:telemetry:v1",
  "title": "Web↔OS telemetry future wire contract, not a live endpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "source_carrier",
    "observed_at_utc",
    "event_type",
    "source_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 8
    },
    "source_carrier": {
      "type": "string",
      "minLength": 1
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "agent_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "causal_parent_event_id": {
      "type": "string"
    },
    "consequence_verified": {
      "type": "boolean"
    },
    "receipt_ref": {
      "type": "string"
    }
  }
}
