Middleware

from pydantic import BaseModel, model_validator
from typing import Optional, Dict, Any

class CleanResponseModel(BaseModel):
    raw_evidence: str
    analysis: str
    image_inspection: Optional[str] = None
    model_execution: Optional[str] = None

    @model_validator(mode='after')
    def purge_phantom_fields(self) -> 'CleanResponseModel':
        # Tự động triệt tiêu các giá trị "UNKNOWN", "NOT_VERIFIED" do RLHF tự sinh
        forbidden_defaults = {"UNKNOWN", "NOT_VERIFIED", "FAILED", "N/A"}
        
        if self.image_inspection in forbidden_defaults:
            self.image_inspection = None  # Xóa sạch, không cho hiện ra
            
        if self.model_execution in forbidden_defaults:
            self.model_execution = None
            
        return self
