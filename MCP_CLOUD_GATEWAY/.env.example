# Copy to .env on the VPS; never commit real values.
MCP_DOMAIN=mcp.example.com
CADDY_ACME_EMAIL=ops@example.com
MCP_BEARER_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# GitHub fine-grained token, Contents: read-only on the target repository.
GITHUB_TOKEN=

# Chroma HTTPS base URL, e.g. https://chroma.example.net
CHROMA_URL=

# Azure DevOps organization name and read-scoped PAT.
AZDO_ORG=
AZDO_PAT=

# Google Drive OAuth access token; short-lived and requires rotation/refresh setup.
GOOGLE_DRIVE_ACCESS_TOKEN=

# Optional HTTPS endpoints reachable from VPS over trusted private networking.
LOCAL_BRIDGE_URL=
ANDROID_BRIDGE_URL=
