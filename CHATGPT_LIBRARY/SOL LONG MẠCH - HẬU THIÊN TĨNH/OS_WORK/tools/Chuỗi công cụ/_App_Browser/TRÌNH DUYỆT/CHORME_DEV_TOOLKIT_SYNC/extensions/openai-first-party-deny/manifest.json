{
  "manifest_version": 3,
  "name": "SOL browser: Block OpenAI first-party domains",
  "version": "1.0.0",
  "description": "Local Chrome profile guard: blocks OpenAI/ChatGPT first-party domains only; does not view cookies or page content.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.openai.com/*",
    "*://*.chatgpt.com/*",
    "*://*.oaistatic.com/*",
    "*://*.oaiusercontent.com/*",
    "*://*.oaistatsig.com/*",
    "*://*.openaimerge.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "sol_openai_domains",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
