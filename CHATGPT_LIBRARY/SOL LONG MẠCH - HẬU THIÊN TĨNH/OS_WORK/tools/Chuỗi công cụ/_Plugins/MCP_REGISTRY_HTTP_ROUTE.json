{
  "schema": "SOL_POWER_ROUTER_ROUTE/1.0",
  "route_id": "mcp-registry-http-ed25519",
  "source_kind": "USER_ATTACHED_SCRIPT",
  "source_filename": "setup_mcp_registry_http.sh",
  "entrypoint": "_Plugins",
  "group": "mcps",
  "carrier": "Chuỗi công cụ/_MCPs/MCP_Registry_HTTP/setup_mcp_registry_http.sh",
  "metadata_kind": "LOCAL_SCRIPT_ROUTE_NOT_CONNECTED_SERVICE",
  "actions": {
    "prepare": {
      "command_template": [
        "bash",
        "setup_mcp_registry_http.sh",
        "prepare",
        "<authorized-domain>",
        "<trusted-public-web-root>"
      ],
      "side_effects": [
        "LOCAL_PRIVATE_KEY_CREATE_IF_MISSING",
        "PUBLIC_PROOF_FILE_WRITE"
      ],
      "requires": [
        "EXPLICIT_AUTHORIZED_TARGET",
        "OPENSSL_ON_AUTHORIZED_HOST",
        "TRUSTED_WEB_ROOT"
      ]
    },
    "login": {
      "command_template": [
        "bash",
        "setup_mcp_registry_http.sh",
        "login",
        "<authorized-domain>"
      ],
      "side_effects": [
        "PROVIDER_AUTHENTICATION"
      ],
      "requires": [
        "MCP_PUBLISHER_INSTALLED",
        "PRIVATE_KEY_ALREADY_PRESENT",
        "PUBLIC_HTTPS_EXACT_MATCH",
        "EXPLICIT_AUTHORIZATION",
        "PRIVATE_KEY_ARGV_RISK_REVIEW"
      ]
    }
  },
  "readback": [
    "LOCAL_PUBLIC_PROOF_ONLY_FOR_PREPARE",
    "EXACT_PUBLIC_HTTPS_RESPONSE_FOR_DEPLOY",
    "PUBLISHER_AUTH_RECEIPT_FOR_LOGIN"
  ],
  "security": {
    "persist_private_key": false,
    "publish_public_key_only": true,
    "auto_login": false,
    "no_credential_in_logs": true,
    "no_automatic_dns_write": true
  },
  "return_to": "_Plugins",
  "deployment_state": "NOT_EXECUTED_ON_USER_DEVICE",
  "notes": "The original script uses --private-key <hex> process arguments for login; assess disclosure risk before invoking."
}
