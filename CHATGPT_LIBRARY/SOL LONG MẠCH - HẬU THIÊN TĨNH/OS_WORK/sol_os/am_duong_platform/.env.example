# Copy to a private .env, or inject via OS/secret manager. Never commit .env.
# The server never automatically reads .env; explicitly export credentials in its process.
SOL_PLATFORM_TOKEN=REPLACE_WITH_RANDOM_TOKEN
SOL_PLATFORM_DB=./.local_state/workrooms.sqlite3
# Only needed for user-approved outbound Translation Basic / Vision calls:
SOL_GOOGLE_CLOUD_API_KEY=
# Local Whisper and ffmpeg are optional binaries, not credentials.
