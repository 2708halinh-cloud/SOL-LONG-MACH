{
  "schema": "SOL_BRAINWAVE_GATE_POLICY/1.0",
  "document_kind": "PUBLIC_METADATA_ONLY",
  "classification": "symbolic_state_machine_not_eeg",
  "ingest_rules": {
    "raw_upload_to_public_repo": false,
    "automatic_drive_or_dropbox_decryption": false,
    "public_pointer_is_not_access_token": true,
    "hash_is_not_encryption": true,
    "encrypt_at_rest_in_private_vault": true,
    "verify_device_origin_and_user_consent": true
  },
  "provenance_required": [
    "entity_id",
    "source_ref",
    "source_revision_or_verified_hash",
    "event_id",
    "source_kind",
    "measured_at",
    "readback_ref"
  ],
  "identity_edges": [
    "REALITY",
    "SPACE",
    "TIME",
    "MIND",
    "POWER"
  ],
  "default_state": "UNBOUND",
  "default_motor_policy": "SAFE_STOP",
  "transitions": [
    {
      "from": "BETA",
      "to": "DELTA",
      "event_kind": "BRAINWAVE_GATE_TRANSITION",
      "next_action": "QUIESCE_NONESSENTIAL_MOTORS",
      "motor_policy": "SAFE_STOP",
      "requires": "VERIFIED_PRIVATE_SOURCE_OR_LABELED_SIMULATION",
      "event_id_generated_at_runtime": true
    },
    {
      "from": "DELTA",
      "to": "BETA",
      "event_kind": "BRAINWAVE_GATE_TRANSITION",
      "next_action": "OBSERVE_AND_REBASELINE",
      "motor_policy": "SAFE_STOP_UNTIL_REAUTHORIZED",
      "requires": "VERIFIED_PRIVATE_SOURCE_OR_LABELED_SIMULATION",
      "event_id_generated_at_runtime": true
    }
  ],
  "physical_actuation": {
    "default": "DISABLED",
    "requires_explicit_user_authorization": true,
    "requires_device_specific_interlock": true
  },
  "notes": "No raw signals, identifiers of private carriers, real source hashes, or credentials in this registry."
}
