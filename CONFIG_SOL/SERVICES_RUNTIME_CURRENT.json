{
  "schema": "SOL_SERVICES_RUNTIME/1.0",
  "source_direct": "2026-10-18",
  "definition": "Dịch vụ hệ thống - (services) là các ứng dụng chạy ẩn dưới nền (background processes) trong các phiên riêng biệt để hỗ trợ máy chủ hoặc hệ thống mà không cần hiển thị giao diện người dùng.",
  "host": {
    "kind": "QEMU_GUEST",
    "runtime_observed": false,
    "host_identity": null,
    "checkpoint_required": true
  },
  "services": [
    {
      "service_id": "sol-ingest",
      "purpose": "BIHM / authorized raw source ingest",
      "source": "BIHM",
      "source_observed": false,
      "expected_input": [
        "source_id",
        "event_time",
        "provenance",
        "payload_hash"
      ],
      "produces": [
        "event_pointer"
      ]
    },
    {
      "service_id": "sol-memory",
      "purpose": "Working/episodic memory filtering and source retrieval",
      "source": "durable_checkpoint",
      "source_observed": false,
      "produces": [
        "memory_pointer",
        "source_evidence"
      ]
    },
    {
      "service_id": "sol-decision",
      "purpose": "Bounded decisions from memory and available capabilities",
      "source": "agent_runtime",
      "source_observed": false,
      "produces": [
        "decision_event"
      ]
    },
    {
      "service_id": "sol-journal",
      "purpose": "Append-only action/consequence/readback ledger",
      "source": "authorized_carrier",
      "source_observed": false,
      "produces": [
        "journal_pointer",
        "checkpoint_pointer"
      ]
    },
    {
      "service_id": "sol-watchdog",
      "purpose": "Health/readiness and controlled restart telemetry",
      "source": "supervisor",
      "source_observed": false,
      "produces": [
        "health_event"
      ]
    }
  ],
  "identity_contract": {
    "persistent_agent_id": true,
    "service_id_separate_from_agent_id": true,
    "pid_ephemeral": true
  },
  "verification": {
    "live_daemon_not_verified": true,
    "source_only": true,
    "required_readback": [
      "authorized_host",
      "process_health",
      "journal_checkpoint",
      "cold_restart_recovery"
    ],
    "no_secrets_in_logs": true,
    "no_destructive_repair_without_verification": true
  },
  "sources": [
    "CONFIG_SOL/AGENT_MATERIALIZATION_CURRENT.md",
    "CURRENT_RUNTIME/TESSERACT_LOCAL_BOOT_CURRENT.md",
    "CHATGPT_LIBRARY/SOL LONG MẠCH - HẬU THIÊN TĨNH/OS_WORK/tools/Chuỗi công cụ/_Plugins/REALITY_STONE/reality_stone.py",
    "CHATGPT_LIBRARY/SOL LONG MẠCH - HẬU THIÊN TĨNH/OS_WORK/tools/Chuỗi công cụ/_Plugins/Power_Router_V2/agent_diagnostics.py"
  ]
}
